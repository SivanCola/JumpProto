{
  "name": "jumpproto",
  "displayName": "JumpProto",
  "description": "%extension.description%",
  "version": "1.1.1",
  "icon": "resources/marketplace-icon.png",
  "publisher": "SivanLiu",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SivanCola/JumpProto.git"
  },
  "homepage": "https://github.com/SivanCola/JumpProto#readme",
  "bugs": {
    "url": "https://github.com/SivanCola/JumpProto/issues"
  },
  "galleryBanner": {
    "color": "#10131d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "proto",
    "protobuf",
    "golang",
    "go",
    "pb.go",
    "jump",
    "definition",
    "navigation",
    "cursor",
    "vscode"
  ],
  "activationEvents": [
    "onLanguage:go",
    "onLanguage:proto",
    "onLanguage:proto3",
    "onLanguage:protobuf",
    "onCommand:protoJump.goToProtoDefinition",
    "onCommand:protoJump.goToGoUsage",
    "onCommand:protoJump.openSettings",
    "onCommand:protoJump.addProtoRoot",
    "onCommand:protoJump.removeProtoRoot",
    "onCommand:protoJump.toggleSearchInWorkspace",
    "onCommand:protoJump.refreshView",
    "onCommand:protoJump.selectLanguage",
    "onCommand:protoJump.editMakeProtoRule",
    "onCommand:protoJump.openMakeProtoRuleHelp",
    "onCommand:protoJump.compileCurrentProto",
    "onCommand:protoJump.diagnoseCurrentSymbol",
    "onCommand:protoJump.testNavigation",
    "onCommand:protoJump.openOutput",
    "onCommand:protoJump.clearCaches",
    "onView:protoJump.view"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "proto",
        "aliases": [
          "Proto",
          "Protocol Buffers",
          "Protobuf"
        ],
        "extensions": [
          ".proto"
        ],
        "configuration": "./resources/proto-language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "protoJump.goToProtoDefinition",
        "title": "%command.jumpToProto%"
      },
      {
        "command": "protoJump.goToGoUsage",
        "title": "%command.jumpToGo%"
      },
      {
        "command": "protoJump.openSettings",
        "title": "%command.openSettings%"
      },
      {
        "command": "protoJump.addProtoRoot",
        "title": "%command.addProtoRoot%"
      },
      {
        "command": "protoJump.removeProtoRoot",
        "title": "%command.removeProtoRoot%"
      },
      {
        "command": "protoJump.toggleSearchInWorkspace",
        "title": "%command.toggleSearchInWorkspace%"
      },
      {
        "command": "protoJump.refreshView",
        "title": "%command.refreshView%"
      },
      {
        "command": "protoJump.selectLanguage",
        "title": "%command.selectLanguage%"
      },
      {
        "command": "protoJump.editMakeProtoRule",
        "title": "%command.editMakeProtoRule%"
      },
      {
        "command": "protoJump.openMakeProtoRuleHelp",
        "title": "%command.makeProtoRuleHelp%"
      },
      {
        "command": "protoJump.compileCurrentProto",
        "title": "%command.compileThisProto%"
      },
      {
        "command": "protoJump.diagnoseCurrentSymbol",
        "title": "%command.diagnoseCurrentSymbol%"
      },
      {
        "command": "protoJump.testNavigation",
        "title": "%command.testNavigation%"
      },
      {
        "command": "protoJump.openOutput",
        "title": "%command.openOutput%"
      },
      {
        "command": "protoJump.clearCaches",
        "title": "%command.clearCache%",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "protoJump.openSettings",
          "when": "false"
        },
        {
          "command": "protoJump.toggleSearchInWorkspace",
          "when": "false"
        },
        {
          "command": "protoJump.refreshView",
          "when": "false"
        },
        {
          "command": "protoJump.selectLanguage",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "protoJump.goToProtoDefinition",
          "when": "editorTextFocus && editorLangId == go",
          "group": "navigation@50"
        },
        {
          "command": "protoJump.goToGoUsage",
          "when": "editorTextFocus && resourceExtname == .proto",
          "group": "navigation@51"
        },
        {
          "command": "protoJump.compileCurrentProto",
          "when": "editorTextFocus && resourceExtname == .proto",
          "group": "navigation@52"
        }
      ],
      "view/item/context": []
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "protoJump",
          "title": "JumpProto",
          "icon": "resources/proto-jump-icon.svg"
        }
      ]
    },
    "views": {
      "protoJump": [
        {
          "id": "protoJump.view",
          "name": "JumpProto",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "protoJump.protoRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.protoRoots.description%"
        },
        "protoJump.uiLanguage": {
          "type": "string",
          "enum": [
            "zh",
            "en"
          ],
          "default": "en",
          "scope": "application",
          "description": "%configuration.uiLanguage.description%"
        },
        "protoJump.searchInWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.searchInWorkspace.description%"
        },
        "protoJump.makeProtoCommand": {
          "type": "string",
          "default": "",
          "description": "%configuration.makeProtoCommand.description%"
        },
        "protoJump.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/vendor/**",
            "**/out/**",
            "**/dist/**",
            "**/.git/**"
          ],
          "description": "%configuration.exclude.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "build": "npm run compile",
    "lint": "tsc -p . --noEmit",
    "dev": "npm run watch",
    "dev:host": "code --extensionDevelopmentPath=.",
    "reinstall:vsix": "npm run vsix && code --install-extension dist/JumpProto.vsix --force",
    "vsix": "npm run compile && node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && npx @vscode/vsce package --out dist/JumpProto.vsix",
    "release:verify": "node scripts/verify-release.mjs",
    "release:verify:metadata": "node scripts/verify-release.mjs --skip-vsix",
    "release:check": "npm run release:verify:metadata && npm test && npm run vsix && npm run release:verify",
    "test": "npm run compile && node --test out/*.test.js",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.70.0",
    "typescript": "^5.7.3"
  }
}
